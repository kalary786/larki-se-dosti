rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function profileKeys() {
      return [
        'uid',
        'username',
        'displayName',
        'shortId',
        'dateOfBirth',
        'gender',
        'country',
        'photos',
        'coins',
        'giftsSentCount',
        'giftsReceivedCount',
        'freeMessagesUsed',
        'level',
        'isOnline',
        'lastSeen',
        'createdAt',
        'onboardingCompleted',
        'isGoogleLinked'
      ];
    }

    function isPendingPhoto(photo) {
      return photo.keys().hasOnly(['id', 'url', 'status'])
        && photo.id is string
        && photo.id.size() > 0
        && photo.id.size() <= 64
        && photo.url is string
        && photo.url.size() > 12
        && photo.url.size() < 2048
        && photo.status == 'pending';
    }

    function matchesExistingPhoto(photo) {
      return photo == resource.data.photos[0]
        || (resource.data.photos.size() > 1 && photo == resource.data.photos[1])
        || (resource.data.photos.size() > 2 && photo == resource.data.photos[2]);
    }

    function photoAllowed(photo) {
      return isPendingPhoto(photo) || matchesExistingPhoto(photo);
    }

    function newPhotoList(list) {
      return list is list
        && list.size() <= 3
        && (list.size() < 1 || isPendingPhoto(list[0]))
        && (list.size() < 2 || isPendingPhoto(list[1]))
        && (list.size() < 3 || isPendingPhoto(list[2]));
    }

    function photoUpdateOk() {
      return request.resource.data.photos == resource.data.photos
        || (
          request.resource.data.photos.size() <= 3
          && (request.resource.data.photos.size() < 1 || photoAllowed(request.resource.data.photos[0]))
          && (request.resource.data.photos.size() < 2 || photoAllowed(request.resource.data.photos[1]))
          && (request.resource.data.photos.size() < 3 || photoAllowed(request.resource.data.photos[2]))
        );
    }

    function validProfile(data) {
      return data.keys().hasOnly(profileKeys())
        && data.uid is string
        && data.username is string
        && data.displayName is string
        && data.shortId is int
        && data.dateOfBirth is string
        && data.gender is string
        && data.country is string
        && data.photos is list
        && data.coins is int
        && (!('giftsSentCount' in data) || data.giftsSentCount is int)
        && (!('giftsReceivedCount' in data) || data.giftsReceivedCount is int)
        && (!('freeMessagesUsed' in data) || data.freeMessagesUsed is int)
        && data.level is int
        && data.isOnline is bool
        && data.lastSeen is int
        && data.createdAt is int
        && data.onboardingCompleted is bool
        && data.isGoogleLinked is bool;
    }

    match /users/{uid} {
      allow read: if signedIn();

      allow create: if isOwner(uid)
        && validProfile(request.resource.data)
        && newPhotoList(request.resource.data.photos)
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.coins == 0
        && request.resource.data.giftsSentCount == 0
        && request.resource.data.giftsReceivedCount == 0
        && request.resource.data.freeMessagesUsed == 0
        && request.resource.data.level == 1
        && request.resource.data.shortId > 0;

      allow update: if isOwner(uid)
        && validProfile(request.resource.data)
        && photoUpdateOk()
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.shortId == resource.data.shortId
        && request.resource.data.coins == resource.data.coins
        && (
          (!('giftsSentCount' in resource.data) && !('giftsSentCount' in request.resource.data))
          || request.resource.data.giftsSentCount == resource.data.giftsSentCount
        )
        && (
          (!('giftsReceivedCount' in resource.data) && !('giftsReceivedCount' in request.resource.data))
          || request.resource.data.giftsReceivedCount == resource.data.giftsReceivedCount
        )
        && (
          (!('freeMessagesUsed' in resource.data) && !('freeMessagesUsed' in request.resource.data))
          || request.resource.data.freeMessagesUsed == resource.data.freeMessagesUsed
        )
        && request.resource.data.level == resource.data.level
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.dateOfBirth == resource.data.dateOfBirth
        && (
          request.resource.data.username == resource.data.username
          || resource.data.onboardingCompleted == false
        );

      allow delete: if isOwner(uid);
    }

    match /usernames/{username} {
      allow read: if signedIn();

      allow create: if signedIn()
        && !exists(/databases/$(database)/documents/usernames/$(username))
        && request.resource.data.keys().hasOnly(['uid'])
        && request.resource.data.uid == request.auth.uid;

      allow delete: if signedIn() && resource.data.uid == request.auth.uid;

      allow update: if false;
    }

    match /counters/users {
      allow read: if signedIn();

      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['next'])
        && request.resource.data.next == 2;

      allow update: if signedIn()
        && request.resource.data.keys().hasOnly(['next'])
        && request.resource.data.next == resource.data.next + 1;

      allow delete: if false;
    }

    match /users/{uid}/coinLedger/{entryId} {
      allow read: if isOwner(uid);
      allow write: if false;
    }

    match /users/{uid}/blocks/{otherUid} {
      allow read: if isOwner(uid);
      allow create: if isOwner(uid)
        && otherUid != uid
        && otherUid.size() > 0
        && otherUid.size() <= 128
        && request.resource.data.keys().hasOnly(['createdAt'])
        && request.resource.data.createdAt is int;
      allow delete: if isOwner(uid);
      allow update: if false;
    }

    match /users/{uid}/blockedBy/{blockerUid} {
      allow read: if isOwner(uid);
      allow create: if signedIn()
        && request.auth.uid == blockerUid
        && blockerUid != uid
        && blockerUid.size() > 0
        && blockerUid.size() <= 128
        && request.resource.data.keys().hasOnly(['createdAt'])
        && request.resource.data.createdAt is int;
      allow delete: if signedIn() && request.auth.uid == blockerUid;
      allow update: if false;
    }

    match /users/{uid}/rateLimits/{name} {
      allow read, write: if false;
    }

    match /config/app {
      allow read: if signedIn();
      allow write: if false;
    }

    match /adRewards/{rewardId} {
      allow read, write: if false;
    }

    match /devices/{deviceIdHash} {
      allow read, write: if false;
    }

    match /deviceLinks/{uid} {
      allow read, write: if false;
    }

    match /gifts/{giftId} {
      allow read: if signedIn();
      allow write: if false;
    }

    match /chats/{chatId} {
      allow read: if signedIn() && request.auth.uid in resource.data.members;
      allow write: if false;

      match /messages/{messageId} {
        allow read: if signedIn()
          && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.members;
        allow write: if false;
      }
    }
  }
}
